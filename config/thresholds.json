{
  "$comment": "Quality gates. A repository must clear these to appear in the main index — this is what keeps the list 'a complete project' rather than every repo that matched a keyword.",
  "version": 1,

  "gates": {
    "min_stars": 120,
    "fast_riser_stars_14d": 60,
    "max_days_since_push": 180,
    "min_doc_score": 22,
    "min_readme_chars": 900,
    "allow_archived": false,
    "min_age_days": 14,
    "exclude_curated_lists": true
  },

  "tiers": {
    "$comment": "Ordered high -> low. First matching tier wins.",
    "flagship":    { "min_score": 78 },
    "recommended": { "min_score": 62 },
    "notable":     { "min_score": 45 },
    "watchlist":   { "min_score": 0 }
  },

  "weights": {
    "$comment": "Health score components. Must sum to 1.0.",
    "popularity": 0.28,
    "momentum": 0.24,
    "maintenance": 0.20,
    "documentation": 0.16,
    "accessibility": 0.12
  },

  "momentum": {
    "$comment": "Star velocity. history_days is how far back a snapshot may be to count as 'recent'.",
    "history_days": 21,
    "min_history_days": 5,
    "young_repo_days": 120,
    "saturate_gain_per_day": 120
  },

  "supersede": {
    "$comment": "Elimination rules. See docs/SUPERSEDE.md.",
    "min_coverage_ratio": 1.0,
    "min_star_advantage": 1.15,
    "min_momentum_advantage": 1.0,
    "max_setup_penalty": 12,
    "dormant_days": 240,
    "min_dominance_score": 0.55,
    "max_challenger_capabilities": 18,
    "max_incumbent_capabilities": 18,
    "min_incumbent_capabilities": 4,
    "min_challenger_capabilities": 5,
    "same_category_only": true
  }
}
