{
  "$comment": "Capability taxonomy. A tool's capabilities are derived by matching these patterns against the README BODY (not the GitHub 'About' field), so a repo is credited for what it actually documents. Patterns must be SPECIFIC: bare words like 'provider', 'memory' or 'proxy' appear in almost every README and caused severe over-detection (tools matching 20+ of 25 capabilities, which then made the elimination engine mark 147 of 255 tools as superseded). Prefer a phrase over a word; drop a pattern entirely if it cannot distinguish a real feature from background prose.",
  "version": 2,

  "capabilities": [
    {
      "id": "multi-account-switching",
      "label": { "en": "Multi-account switching", "zh": "多账号切换" },
      "problem": {
        "en": "One subscription's quota runs out; you need to rotate between several accounts without re-logging-in by hand.",
        "zh": "单个订阅额度会用完，需要在多个账号之间轮换，而不必手动重新登录。"
      },
      "patterns": [
        "switch(ing)? between (multiple |several |different )?accounts",
        "switch accounts?", "account switch(er|ing)?", "multi[- ]?account",
        "multiple (chatgpt |github |xai |openai |claude |grok )?accounts",
        "(several|multiple|more) accounts (per|for|under)",
        "(sign in|login|log in) to (multiple|several|more) accounts",
        "account (pool|manager|management|rotation|to use|selector)",
        "pool of accounts", "rotate (between )?accounts", "add (multiple|more) accounts",
        "choose an .{0,20}account", "per[- ]account",
        "move[sd]? to (another|the next|a different) account",
        "fail(s|over)? (over )?between (them|accounts)",
        "轮换账号", "多账号", "多账户", "账号切换", "切换账号", "号池", "账户切换", "多个账号", "账号管理"
      ]
    },
